# A .env file beside the working directory is loaded automatically; real shell
# variables always take precedence over anything set here.
ECONOCONTEXT_DATA_DIR=./data
ECONOCONTEXT_BACKEND=scripted
# Live mode requires explicit capacity, model, credential, and an endpoint.
# ECONOCONTEXT_BACKEND=openai
# ECONOCONTEXT_BASE_URL=https://api.openai.com/v1
# ECONOCONTEXT_MODEL=your-model-identifier
# ECONOCONTEXT_LIVE_CONTEXT_TOKENS=16384
# ECONOCONTEXT_CREDENTIAL_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=replace-locally-never-commit
# ECONOCONTEXT_OUTPUT_PARAMETER=max_completion_tokens
# Older compatible endpoints may require max_tokens instead.
# Google Vertex AI (OpenAI-compatible, verified 2026-09-21) needs a different
# auth header, a publisher-prefixed model, and max_tokens:
# ECONOCONTEXT_BASE_URL=https://aiplatform.googleapis.com/v1/projects/PROJECT/locations/global/endpoints/openapi
# ECONOCONTEXT_MODEL=google/gemini-3.5-flash
# ECONOCONTEXT_AUTH_HEADER=x-goog-api-key
# ECONOCONTEXT_AUTH_SCHEME=
# ECONOCONTEXT_OUTPUT_PARAMETER=max_tokens
# ECONOCONTEXT_TIMEOUT=30
# ECONOCONTEXT_PRICING='{"revision":"your-price-date","input_per_million":1,"cached_per_million":0.25,"output_per_million":2}'
# Above rates are examples, NOT provider prices. Replace before live optimized use.
# ECONOCONTEXT_PROFILE_PATH=./profiles.json   # built by `econocontext profiles`
