# Default-deny: datasets, nested upstream checkout, secrets, and raw traces stay local.
*
!.gitignore
!README.md
!bcp/
bcp/*
!bcp/RUN.md
!bcp/SEARCH_RUN.md
!bcp/SETUP.md
!bcp/run.sh
!bcp/run_search.sh
!bcp/run_pilot.py
!bcp/pilot.env.example
!bcp/pilot-002.env.example
!bcp/pilot-003.env.example
!bcp/settings.json
!bcp/reports/
bcp/reports/*
!bcp/reports/three-question-token-comparison.html
!bcp/reports/RESULTS.md
