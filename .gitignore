.DS_Store
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Run state: the store auto-creates on first run. Derived data, and it holds
# full prompts and model output.
data/
.env

# Call logs contain full prompts and model output.
*.log

# Design source documents stay local.
*.docx
*.pptx
logs/

# v1 local stores created by examples
.econocontext/

# EconoCLM: run outputs (full prompts, outputs, ledgers) and any secrets file.
econoclm/runs/
.venv-econoclm/
runs/
*.env
secrets.env

# Qwen runs: per-trial folders are large; only the summary files are committed.
runs-qwen/*/trials/
